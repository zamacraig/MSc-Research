{
  "run_name": "impvattnv2",

  "model_type": ["temporal_attention"],

  "epochs": [60],
  "lr": [0.0002],
  "weight_decay": [0.01],
  "hidden_channels": [32],
  "in_channels": 12,
  "num_classes": [3],
  "train_ratio": 0.8,
  "test_holdout_ratio": 0.2,
  "seed": [42, 123, 456],
  "device": "cpu",
  "optimizer": "adam",

  "scheduler": {
    "name": "CosineAnnealingLR",
    "T_max": 60,
    "eta_min": 0.00001
  },

  "early_stopping_patience": 15,
  "early_stopping_min_delta": 0.001,
  "save_best": true,
  "eval_interval": 1,
  "plot_nodes_per_timestamp": true,

  "data_path": "Dataset/TransientData/processedData.csv",
  "processed_data_path": "Dataset/TransientData/processedData.csv",
  "save_dir": "src/masters_research/artifacts/models",
  "plots_dir": "src/masters_research/artifacts/plots",

  "enable_explainability": false,
  "gnnexplainer_nodes": 5,
  "gnnexplainer_epochs": 100,
  "ig_nodes": 5,
  "ig_steps": 50,

  "use_attention": false,
  "gat_heads": 4,

  "stratified_split": true,
  "n_cv_folds": 1,

  "gru_layers": 1,
  "gcn_layers": 2,

  "temporal_quality_audit": true,

  "focal_loss": true,
  "focal_gamma": 1.0,
  "label_smoothing": 0.02,
  "entropy_reg": 0.01,
  "classifier_l2": 0.001,

  "input_norm": true,
  "warmup_epochs": 10,

  "seasonal_normalization": true,
  "add_lag_features": true,

  "use_temporal_attention": false,
  "use_simple_gcn": false,

  "temporal_history_len": 5,
  "temporal_heads": 2,
  "attention_gate_init": [0.0, 1.0],
  "attention_dropout": 0.3,

  "dropout": 0.3,
  "grad_clip": 0.5,

  "use_swa": false,
  "swa_start_epoch": 40,
  "swa_lr": 0.0002,

  "class_weight_source": "trainval",
  "logit_adjustment": true,
  "ordinal_loss": [false, true],
  "ordinal_lambda": 0.1
}
