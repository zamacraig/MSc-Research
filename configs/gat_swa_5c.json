{
  "_comment": "GAT + SWA experiment with 5 classes",
  
  "model_type": "temporal_attention",
  
  "use_gat": true,
  "gat_heads": [2, 4],
  
  "hidden_channels": [32, 48],
  "temporal_heads": 2,
  "temporal_history_len": 10,
  
  "gru_layers": 1,
  "gcn_layers": 2,
  "dropout": 0.3,
  
  "lr": 0.0003,
  "weight_decay": 0.01,
  
  "use_swa": true,
  "swa_start_epoch": 40,
  "swa_lr": 0.0001,
  
  "epochs": 100,
  "in_channels": 12,
  "num_classes": 5,
  "train_ratio": 0.8,
  "test_holdout_ratio": 0.2,
  "seed": 42,
  "device": "cpu",
  "optimizer": "adam",
  
  "scheduler": {
    "name": "CosineAnnealingLR",
    "T_max": 100,
    "eta_min": 0.00001
  },
  
  "early_stopping_patience": 35,
  "early_stopping_min_delta": 0.001,
  "save_best": true,
  "eval_interval": 1,
  "run_name": "gat_swa_5c",
  
  "data_path": "Dataset/TransientData/processedData.csv",
  "save_dir": "src/masters_research/artifacts/models",
  "plots_dir": "src/masters_research/artifacts/plots",
  
  "temporal_quality_audit": false,
  "plot_nodes_per_timestamp": false,
  
  "seasonal_normalization": true,
  "add_lag_features": false,
  
  "input_norm": true,
  
  "focal_loss": true,
  "focal_gamma": 1.0,
  "label_smoothing": 0.0,
  "entropy_reg": 0.01,
  "classifier_l2": 0.001,
  
  "warmup_epochs": 10,
  "grad_clip": 1.0,
  
  "n_cv_folds": 1,
  "stratified_split": false,
  
  "enable_explainability": false
}
